# Configure these values for local development. Keep the populated .env file out of source control.
ASPNETCORE_ENVIRONMENT=Development
API_PORT=9005
DOCKER_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=9000
RABBITMQ_AMQP_PORT=9001
RABBITMQ_MANAGEMENT_PORT=9002
MINIO_API_PORT=9003
MINIO_CONSOLE_PORT=9004

# Pin infrastructure images here; update them deliberately after compatibility review.
POSTGRES_IMAGE=postgres:18.6
RABBITMQ_IMAGE=rabbitmq:4.4.0-management
MINIO_IMAGE=local-godelivery-core-minio:RELEASE.2025-10-15T17-29-55Z
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
MINIO_BUILD_IMAGE=golang:1.27.3-bookworm
MINIO_RUNTIME_IMAGE=debian:13.7-slim

POSTGRES_USER=coregodelivery
POSTGRES_PASSWORD=
POSTGRES_DB=dbgodelivery
POSTGRES_PGDATA=/var/lib/postgresql/18/docker
DATABASE_TIMEOUT_SECONDS=30
DATABASE_GSS_ENCRYPTION_MODE=Disable

RABBITMQ_DEFAULT_USER=coregodelivery
RABBITMQ_DEFAULT_PASS=
RABBITMQ_QUEUE_PUBLISH=motorcycle_notification_queue
RABBITMQ_QUEUE_CONSUMER=motorcycle_notification_queue
RABBITMQ_CONNECTION_RETRY_COUNT=5
RABBITMQ_RETRY_INITIAL_DELAY_SECONDS=2

MINIO_ROOT_USER=coregodelivery
MINIO_ROOT_PASSWORD=
MINIO_USE_SSL=false
MINIO_LICENSE_BUCKET=license-cnh

# Local-only Keycloak issuer. Create realm users in the admin console after startup.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_HOSTNAME=http://keycloak.localhost:8080
JWT_AUTHORITY=http://keycloak.localhost:8080/realms/godelivery
JWT_AUDIENCE=coregodelivery-api
JWT_REQUIRE_HTTPS_METADATA=false
